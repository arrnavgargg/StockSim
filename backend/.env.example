# ==========================================
# StockSim Backend Configuration
# ==========================================

# Application
PROJECT_NAME="StockSim API"
VERSION="1.0.0"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database connection
# Default: PostgreSQL
DATABASE_URL="postgresql+psycopg://stocksim_user:strong-password@localhost:5432/stocksim"
# Local SQLite fallback (useful for standalone backend/frontend dev without PostgreSQL running):
# DATABASE_URL="sqlite:///./stocksim.db"
DB_ECHO=False

# Security & JWT Auth
# Run `openssl rand -hex 32` to generate a secure secret key
SECRET_KEY="generate-a-very-strong-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Virtual Trading Simulation Defaults
STARTING_WALLET_BALANCE=10000.00
STARTING_WALLET_CURRENCY="USD"

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
